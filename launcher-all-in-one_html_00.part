    var n=$("d"+k);if(!n)return Promise.reject(new Error("section d"+k+" missing"));
    p=Promise.resolve(n.textContent);
  }
  return p.then(function(t){cache.unshift([k,t]);if(cache.length>3)cache.pop();return t});
}
var B64=null;
function b64bytes(s){
  if(Uint8Array.fromBase64)return Uint8Array.fromBase64(s);
  var b=atob(s),u=new Uint8Array(b.length);for(var i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u;
}
function inflate(u){
  return new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream("deflate-raw"))).arrayBuffer().then(function(a){return new Uint8Array(a)});
}
function chunk(id){
  var T=IDX.tbl,o=id*4,pk=T[o],off=T[o+1],len=T[o+2],me=T[o+3];
  return packText(pk).then(function(t){
    var u=b64bytes(t.substr(off,len));
    return me?inflate(u):u;
  });
}

// ---------------- record decoder: stored stream -> final HTML bytes ----------------
// Stored stream = records [type u8][len u32le][payload]; type 0 = text bytes as-is, type 1 = binary that was a
// base64 run in the original file (re-encoded to base64 here, streaming).
var ALPHA=new Uint8Array(64),AL="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
for(var ai=0;ai<64;ai++)ALPHA[ai]=AL.charCodeAt(ai);
function Decoder(emit){
  var hdr=new Uint8Array(5),hn=0,type=0,rem=0,carry=new Uint8Array(3),cn=0;
  function enc3(a,b,c,o,i){o[i]=ALPHA[a>>2];o[i+1]=ALPHA[((a&3)<<4)|(b>>4)];o[i+2]=ALPHA[((b&15)<<2)|(c>>6)];o[i+3]=ALPHA[c&63]}
  this.push=function(u){
    var p=0,n=u.length;
    while(p<n){
      if(rem===0){
        while(hn<5&&p<n)hdr[hn++]=u[p++];
        if(hn<5)return;
        hn=0;type=hdr[0];rem=(hdr[1]|(hdr[2]<<8)|(hdr[3]<<16)|(hdr[4]*16777216))>>>0;cn=0;
        if(rem===0)continue;
        continue;
      }
      var take=Math.min(rem,n-p);
      if(type===0){emit(u.subarray(p,p+take));p+=take;rem-=take}
      else{
        var end=p+take,out=new Uint8Array(((take+cn+2)/3|0)*4+4),o=0;
        while(cn>0&&cn<3&&p<end)carry[cn++]=u[p++];
        if(cn===3){enc3(carry[0],carry[1],carry[2],out,o);o+=4;cn=0}
        var full=p+((end-p)/3|0)*3;
        for(;p<full;p+=3,o+=4)enc3(u[p],u[p+1],u[p+2],out,o);
        while(p<end)carry[cn++]=u[p++];
        rem-=take;
        if(rem===0&&cn>0){
          if(cn===1){out[o]=ALPHA[carry[0]>>2];out[o+1]=ALPHA[(carry[0]&3)<<4];out[o+2]=61;out[o+3]=61}
          else{out[o]=ALPHA[carry[0]>>2];out[o+1]=ALPHA[((carry[0]&3)<<4)|(carry[1]>>4)];out[o+2]=ALPHA[(carry[1]&15)<<2];out[o+3]=61}
          o+=4;cn=0;
        }
        emit(o===out.length?out:out.subarray(0,o));
      }
    }
  };
}
// run one stored file through the decoder into sink.write(u8); resolves when finished
function pump(key,sink,progress,cancelled){
  var f=IDX.f[key],ids=f.c,i=0,dec=new Decoder(function(u){sink.write(u)});
  return new Promise(function(res,rej){
    (function next(){
      if(cancelled())return rej(new Error("cancelled"));
      if(i>=ids.length)return res();
      chunk(ids[i]).then(function(u){
        dec.push(u);i++;
        if(progress&&(i&15)===0)progress(i/ids.length);
        if((i&31)===0)setTimeout(next,0);else next();
      },rej);
    })();
  });
}
function BlobSink(inj){var parts=[],sz=0,acc=null;
  this.write=function(u){
    if(inj){var h=inj;inj=null;           // blob: documents have a non-hierarchical base URL; give them a real one (<base>) so new URL(rel, document.baseURI) works
      var n=Math.min(u.length,8192),hd=new TextDecoder("latin1").decode(u.subarray(0,n)),i=hd.search(/<head[^>]*>/i);
      if(i>=0){var e=hd.indexOf(">",i)+1,ins=new TextEncoder().encode(h),o=new Uint8Array(u.length+ins.length);o.set(u.subarray(0,e));o.set(ins,e);o.set(u.subarray(e),e+ins.length);u=o}}
parts.push(u);sz+=u.length;if(sz>=33554432){acc=new Blob(acc?[acc].concat(parts):parts);parts=[];sz=0}};
  this.done=function(){var b=new Blob(acc?[acc].concat(parts):parts,{type:"text/html"});parts=null;acc=null;return b};
}
function TextSink(enc){var dec=new TextDecoder(enc),out=[];
  this.write=function(u){out.push(dec.decode(u,{stream:true}))};
  this.done=function(){out.push(dec.decode());var s=out.join("");out=null;return s};
}

// ---------------- launcher-side low-memory FPS cap (same-origin only, best effort) ----------------
function patch(w){
  try{
    if(!cfg.lm||w.__lmp||!w.requestAnimationFrame)return false;
    w.__lmp=1;
    var raf=w.requestAnimationFrame.bind(w),caf=w.cancelAnimationFrame.bind(w),iv=1000/cfg.fps,last=-1e9,n=0,map={};
    w.requestAnimationFrame=function(cb){
      var id=++n,step=function(ts){
        if(!(id in map))return;
        if(ts!==last&&ts-last<iv-1){map[id]=raf(step);return}
        last=ts;delete map[id];cb(ts)};
      map[id]=raf(step);return id};
    w.cancelAnimationFrame=function(id){if(id in map){caf(map[id]);delete map[id]}};
    return true;
  }catch(e){return false}
}
function stopPoll(){if(pollId){clearInterval(pollId);pollId=0}}

function destroy(){
  token++;
  stopPoll();
  if(frame){
    frame.onload=null;
    try{var w=frame.contentWindow;if(w){try{w.stop()}catch(e){}}}catch(e){}
    frame.src="about:blank";
    try{frame.removeAttribute("src")}catch(e){}
    if(frame.parentNode)frame.parentNode.removeChild(frame);
    frame=null;
  }
  if(blobUrl){try{URL.revokeObjectURL(blobUrl)}catch(e){}blobUrl=null}
  packsText=null;cache.length=0;
  stage.textContent="";
  active=false;
  document.body.classList.remove("playing");document.body.classList.remove("busy");
  document.title="Eagler Launcher (all-in-one)";
}
function setMsg(t,cancelable){
  msg.textContent=t||"";
  if(cancelable){var b=document.createElement("button");b.textContent="Cancel";b.onclick=function(){destroy();setMsg("Cancelled.")};msg.appendChild(b)}
}
window.__eaglPacksText=function(){return packsText};            // used by the patched Chromium builds
window.__eaglNavigate=function(url){                            // used by the patched Chromium launcher
  var m=/Chromium-Client-(\w+)\.html(#.*)?$/.exec(String(url));
  if(!m||!IDX.f["chromium-client-"+m[1]])return false;
  setTimeout(function(){if(!active)return;destroy();start("Chromium",  "chromium-client-"+m[1],m[2]||"")},0);
  return true;
};

function start(title,key,hash){
  if(active)return;                 // one client at a time
  destroy();
  active=true;document.body.classList.add("busy");
  var my=token,cancelled=function(){return my!==token},f=IDX.f[key];
  var needPacks=key.indexOf("chromium-client-")===0;
  setMsg("Unpacking "+title+" \u2026 0%",true);
  var prog=function(x){if(!cancelled())setMsg("Unpacking "+title+" \u2026 "+Math.round(x*100)+"%",true)};
  var prep=null,packSink=null;
  if(needPacks){packSink=new TextSink("utf-8");prep=pump("chromium-packs",packSink,null,cancelled).then(function(){packsText=packSink.done()})}
  Promise.resolve(prep).then(function(){
    if(cancelled())throw new Error("cancelled");
    var sc=cfg.lm?cfg.scale:1;
    frame=document.createElement("iframe");
    frame.setAttribute("allow","fullscreen *; autoplay *; clipboard-read *; clipboard-write *; gamepad *; keyboard-map *");
    frame.setAttribute("allowfullscreen","");
    frame.title=title;
    frame.style.width=(sc*100)+"%";frame.style.height=(sc*100)+"%";
    if(sc!==1)frame.style.transform="scale("+(1/sc)+")";
    var fr=frame;
    if(isHttp){
      var sink=new BlobSink(key==="gold"?'<base href="'+location.href.split("#")[0].split("?")[0]+'">':null);
      return pump(key,sink,prog,cancelled).then(function(){
        if(cancelled())throw new Error("cancelled");
        var blob=sink.done();sink=null;
        blobUrl=URL.createObjectURL(blob);blob=null;
        var bu=blobUrl;
        fr.onload=function(){patch(fr.contentWindow);try{URL.revokeObjectURL(bu)}catch(e){}if(blobUrl===bu)blobUrl=null};
        fr.src=bu+hash;                 // set before attaching so no about:blank load event fires first
        stage.appendChild(fr);
        document.body.classList.add("playing");setMsg("");
        document.title=title+" \u2013 Eagler Launcher";
        if(cfg.lm){pollEnd=Date.now()+15000;stopPoll();
          pollId=setInterval(function(){
            if(!frame||Date.now()>pollEnd){stopPoll();return}
            try{if(frame.contentWindow.location.href!=="about:blank"&&patch(frame.contentWindow))stopPoll()}catch(e){}},4)}
      });
    }
    // file:// (and anything non-http): blob iframes get an opaque origin there (no storage), so stream the HTML into an
    // about:blank iframe with document.write; that document inherits this page's origin and keeps localStorage/IndexedDB.
    stage.appendChild(fr);
    document.body.classList.add("playing");
    document.title=title+" \u2013 Eagler Launcher";
    var d=fr.contentDocument,w=fr.contentWindow,td=new TextDecoder(f.e||"utf-8");
    d.open();
    if(hash){try{w.history.replaceState(null,"",hash)}catch(e){}}
    patch(w);
    var wsink={write:function(u){var t=td.decode(u,{stream:true});if(t)d.write(t)}};
    return pump(key,wsink,prog,cancelled).then(function(){
      if(cancelled())throw new Error("cancelled");
      var t=td.decode();if(t)d.write(t);
      d.close();setMsg("");
    });
  }).catch(function(e){
    if(e&&e.message==="cancelled")return;
    destroy();setMsg("Could not start "+title+": "+(e&&e.message||e)+(isHttp?"":" (file:// mode)"));
  });
}

$("back").onclick=function(){
  if(!active)return;
  if(confirm("Close the game and return to the launcher? Unsaved progress in the current session may be lost."))destroy();
};

// ---------------- optional RAM trim (http/https only) ----------------
// Once the page has loaded, if the server supports HTTP Range requests, verify that we can re-read our own bytes and then
// drop the big data sections from the DOM, so only the launcher UI stays in memory. Sections are re-fetched on Launch.
function trim(){
  var el=$("trim");
  if(!isHttp){el.textContent="Opened from "+location.protocol+" : data sections stay in this page's memory (no server to re-fetch from). Games run inside this page's own origin so saves keep working.";return}
  var url=location.href.split("#")[0],ac=new AbortController();
  fetch(url,{headers:{Range:"bytes=0-0"},cache:"no-store",signal:ac.signal}).then(function(r){
    var cr=r.headers.get("content-range")||"",m=/\/(\d+)$/.exec(cr);
    var ok=r.status===206&&m&&!r.headers.get("content-encoding");
    ac.abort();
    if(!ok)throw new Error("server has no usable Range support");
    var base=+m[1]-IDX.N,a=base+IDX.po[0],n=$("d0");
    return fetch(url,{headers:{Range:"bytes="+a+"-"+(a+IDX.pl[0]-1)},cache:"no-store"}).then(function(r2){
      if(r2.status!==206)throw new Error("range check failed");return r2.text()}).then(function(t){
      if(!n||t!==n.textContent)throw new Error("range content mismatch");
      return base});
  }).then(function(base){
    rbase=base;mode="range";cache.length=0;
    var nodes=document.querySelectorAll("script[id^=d]");
    for(var i=nodes.length-1;i>=0;i--)nodes[i].parentNode.removeChild(nodes[i]);
    el.textContent="RAM trim active: client data was released from memory and is re-read from the file on Launch (HTTP Range).";
  }).catch(function(e){el.textContent="RAM trim off ("+(e&&e.message||e)+"): data sections stay in this page's memory."});
}
$("envnote").textContent=isHttp?"Running from "+location.origin+".":"Running from "+location.protocol+" (no server). Works offline; storage lives in this file's origin.";
build();syncLm();
window.addEventListener("load",function(){setTimeout(trim,50)});
})();
</script>
